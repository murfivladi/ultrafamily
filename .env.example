# FTP-деплой использует как канонический файл ./.env в корне FTP-аккаунта.
# Не создавайте .env внутри artifact/, payload/, apps/api/ или apps/web/.
# Автоматические значения добавляются только если ключа ещё нет; ваши строки
# и комментарии сохраняются. Остальные installation-specific значения и
# настройки первого запуска вводятся вручную в .env и существующей админке
# платформы. Не размещайте реальные пароли в git.

# Ultra Family OS — copy to .env for local development. Never commit production secrets.

# Runtime
NODE_ENV=development
APP_VERSION=0.1.0-stage-d
API_PORT=25031
WEB_PORT=26288
APP_ORIGIN=

# Database: leave DATABASE_URL empty to use embedded PostgreSQL for the preview.
# Production must set DB_DRIVER=postgres and a PostgreSQL connection string.
DB_DRIVER=auto
DATABASE_URL=
DATABASE_SSL=false
DB_POOL_SIZE=8
PGLITE_DATA_DIR=.data/pglite

# Security — required in production, generated per installation.
SESSION_SECRET=replace-with-a-long-random-value

# First bootstrap. In production BOOTSTRAP_OWNER_PASSWORD is mandatory.
BOOTSTRAP_OWNER_EMAIL=owner@ultra.family
BOOTSTRAP_OWNER_PASSWORD=FamilyOS!2026
SEED_DEMO_DATA=true

# Next.js proxies browser-relative /api requests to the INTERNAL backend.
# https://api.family.vladislavb.qzz.io stays as the public reverse-proxy address in docs only.
# APP_ORIGIN is already set in the hosting .env; the workflow preserves it.
API_PROXY_ORIGIN=http://127.0.0.1:25031
NEXT_PUBLIC_DEMO_PASSWORD=FamilyOS!2026

# Stage C realtime: /ws is proxied to the API by scripts/ws-proxy.mjs.
WS_PUBLIC_PORT=26288
WS_NEXT_PORT=3000
WS_API_PORT=25031
WS_API_HOST=127.0.0.1

# Stage C WebRTC. STUN alone works on simple networks; TURN is required for
# symmetric NAT / mobile networks. Media is P2P and never flows through FTP/HTTP.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# WEBRTC_TURN_URLS=turn:turn.example.org:3478?transport=udp,turns:turn.example.org:5349
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=

# Stage D file storage. Local disk is NOT a backup: back up STORAGE_DIR off-VPS.
# STORAGE_DRIVER=s3 is reserved for a future S3-compatible adapter.
STORAGE_DRIVER=local
STORAGE_DIR=.data/storage
STORAGE_SPACE_QUOTA_BYTES=21474836480
STORAGE_USER_QUOTA_BYTES=10737418240
STORAGE_MAX_FILE_BYTES=4294967296
STORAGE_CHUNK_BYTES=4194304
STORAGE_MIN_FREE_BYTES=2147483648
STORAGE_TRASH_RETENTION_DAYS=30

# Stage D media queue: optional LOCAL engines, run without a shell; {input} is
# replaced by the file path. Leave empty when not installed.
# ANTIVIRUS_COMMAND=clamscan --no-summary {input}
# OCR_COMMAND=tesseract {input} stdout -l rus+ita+eng
# VIDEO_PROBE_COMMAND=ffprobe -v quiet -print_format json -show_format {input}
# FACE_ENGINE_COMMAND=
MEDIA_QUEUE_INTERVAL_MS=5000
MEDIA_QUEUE_CONCURRENCY=1
MEDIA_COMMAND_TIMEOUT_MS=120000

# Optional external integrations, intentionally empty in Stage B.
# POLZA_API_KEY=
# SMTP_URL=
# TELEGRAM_BOT_TOKEN=
